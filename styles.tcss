/* Screen & Global Styling */
Screen {
    background: #0a0e14;
    color: #00ff66;
    font-family: monospace;
}

Header {
    background: #002b11;
    color: #00ff66;
    dock: top;
}

Footer {
    background: #001a0a;
    color: #ffb000;
    dock: bottom;
}

/* Main 3-Column Layout Workspace */
#workspace {
    layout: grid;
    grid-size: 3;
    grid-columns: 3fr 1fr 1fr;
    height: 82%;
    padding: 0 1;
}

/* Individual Panel Containers */
#code-container {
    border: heavy #00ff66;
    background: #05080c;
    margin: 1;
    padding: 1;
}

#inspector-container {
    border: heavy #00ccff;
    background: #05080c;
    margin: 1;
    padding: 1;
}

#watchlist-container {
    border: heavy #ffb000;
    background: #05080c;
    margin: 1;
    padding: 1;
}

.pane-title {
    font-weight: bold;
    color: #00ff66;
    margin-bottom: 1;
    text-align: center;
}

/* DataTable Styling */
DataTable {
    background: transparent;
    border: none;
}

DataTable > .datatable--header {
    background: #002b11;
    color: #00ccff;
    text-style: bold;
}

/* Selection List Widget */
SelectionList {
    background: transparent;
    border: none;
}

SelectionList > .selection-list--button {
    color: #ffb000;
}

/* Timeline Container (Bottom) */
#timeline-panel {
    height: 18%;
    background: #001a0a;
    border-top: heavy #ffb000;
    align: center middle;
    padding: 1;
}

#timeline-label {
    color: #ffb000;
    text-style: bold;
    padding: 1 2;
}

Slider {
    width: 80%;
    color: #00ff66;
}
